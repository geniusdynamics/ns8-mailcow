[Unit]
Description=mailcow rspamd (spam filter, DKIM)
BindsTo=mailcow.service
After=mailcow.service php-fpm-mailcow-app.service dovecot-mailcow-app.service unbound-mailcow-app.service redis-mailcow-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.ctr-id
ExecStart=/usr/bin/podman run --detach --conmon-pidfile=%t/%N.pid --cidfile=%t/%N.ctr-id --cgroups=no-conmon \
    --pod-id-file=%t/mailcow.pod-id --replace --name=%N --log-opt=tag=%N \
    --label=com.docker.compose.project=mailcowdockerized --label=com.docker.compose.service=rspamd-mailcow \
    --env-file=mailcow.env \
    --volume=%E/state/mailcow/hooks/rspamd:/hooks:Z \
    --volume=%E/state/mailcow/conf/rspamd/custom:/etc/rspamd/custom:z \
    --volume=%E/state/mailcow/conf/rspamd/override.d:/etc/rspamd/override.d:Z \
    --volume=%E/state/mailcow/conf/rspamd/local.d:/etc/rspamd/local.d:Z \
    --volume=%E/state/mailcow/conf/rspamd/plugins.d:/etc/rspamd/plugins.d:Z \
    --volume=%E/state/mailcow/conf/rspamd/lua:/etc/rspamd/lua:ro,Z \
    --volume=%E/state/mailcow/conf/rspamd/rspamd.conf.local:/etc/rspamd/rspamd.conf.local:Z \
    --volume=%E/state/mailcow/conf/rspamd/rspamd.conf.override:/etc/rspamd/rspamd.conf.override:Z \
    --volume=rspamd-vol-1:/var/lib/rspamd:z \
    ${RSPAMD_IMAGE}
ExecStartPost=%E/bin/wait-ready exec %N 840 bash -c "exec 3<>/dev/tcp/127.0.0.1/11334"
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%N.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/%N.ctr-id
PIDFile=%t/%N.pid
Type=forking
SyslogIdentifier=%N

[Install]
WantedBy=default.target
