[Unit]
Description=mailcow Dovecot (IMAP, POP3, ManageSieve, LMTP)
BindsTo=mailcow.service
After=mailcow.service mysql-mailcow-app.service redis-mailcow-app.service unbound-mailcow-app.service php-fpm-mailcow-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.ctr-id
ExecStart=/usr/bin/podman run --detach --conmon-pidfile=%t/%N.pid --cidfile=%t/%N.ctr-id --cgroups=no-conmon \
    --pod-id-file=%t/mailcow.pod-id --replace --name=%N --log-opt=tag=%N \
    --label=com.docker.compose.project=mailcowdockerized --label=com.docker.compose.service=dovecot-mailcow \
    --tty \
    --env-file=mailcow.env \
    --volume=%E/state/mailcow/hooks/dovecot:/hooks:Z \
    --volume=%E/state/mailcow/conf/dovecot:/etc/dovecot:z \
    --volume=%E/state/ssl:/etc/ssl/mail:ro,z \
    --volume=%E/state/mailcow/conf/sogo:/etc/sogo:z \
    --volume=%E/state/mailcow/conf/phpfpm/sogo-sso:/etc/phpfpm:z \
    --volume=vmail-vol-1:/var/vmail:Z \
    --volume=vmail-index-vol-1:/var/vmail_index:Z \
    --volume=crypt-vol-1:/mail_crypt:z \
    --volume=%E/state/mailcow/conf/rspamd/custom:/etc/rspamd/custom:z \
    --volume=%E/state/mailcow/assets/templates:/templates:z \
    --volume=rspamd-vol-1:/var/lib/rspamd:z \
    --volume=mysql-socket-vol:/var/run/mysqld:z \
    ${DOVECOT_IMAGE}
ExecStartPost=%E/bin/wait-ready exec %N 840 bash -c "exec 3<>/dev/tcp/127.0.0.1/143"
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%N.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/%N.ctr-id
ExecReload=/usr/bin/podman exec %N doveadm reload
PIDFile=%t/%N.pid
Type=forking
SyslogIdentifier=%N

[Install]
WantedBy=default.target
