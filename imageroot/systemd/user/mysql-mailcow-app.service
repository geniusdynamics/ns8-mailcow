[Unit]
Description=mailcow MariaDB
BindsTo=mailcow.service
After=mailcow.service
Before=php-fpm-mailcow-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.ctr-id
ExecStart=/usr/bin/podman run --detach --conmon-pidfile=%t/%N.pid --cidfile=%t/%N.ctr-id --cgroups=no-conmon \
    --pod-id-file=%t/mailcow.pod-id --replace --name=%N --log-opt=tag=%N \
    --label=com.docker.compose.project=mailcowdockerized --label=com.docker.compose.service=mysql-mailcow \
    --env-file=mysql.env \
    --volume=mysql-vol:/var/lib/mysql:Z \
    --volume=mysql-socket-vol:/var/run/mysqld:z \
    --volume=%E/state/mailcow/conf/mysql:/etc/mysql/conf.d:ro,z \
    ${MARIADB_IMAGE}
ExecStartPost=/usr/bin/podman exec %N /bin/bash -c "for i in $$(seq 1 120); do mariadb-admin ping --silent -uroot -p\"$$MYSQL_ROOT_PASSWORD\" >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1"
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%N.ctr-id -t 45
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/%N.ctr-id
PIDFile=%t/%N.pid
Type=forking
SyslogIdentifier=%N

[Install]
WantedBy=default.target
