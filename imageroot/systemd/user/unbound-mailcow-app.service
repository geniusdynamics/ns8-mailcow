#
# Recursive resolver of the pod (pod DNS: 127.0.0.1). rspamd and postfix query
# DNS blocklists, which refuse queries forwarded by public resolvers.

[Unit]
Description=mailcow unbound, the DNS resolver of the pod
BindsTo=mailcow.service
After=mailcow.service
Before=dockerapi.service php-fpm-mailcow-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%N.pid %t/%N.ctr-id
ExecStart=/usr/bin/podman run --detach --conmon-pidfile=%t/%N.pid --cidfile=%t/%N.ctr-id --cgroups=no-conmon \
    --pod-id-file=%t/mailcow.pod-id --replace --name=%N --log-opt=tag=%N \
    --label=com.docker.compose.project=mailcowdockerized --label=com.docker.compose.service=unbound-mailcow \
    --tty \
    --env-file=mailcow.env \
    --volume=%E/state/mailcow/hooks/unbound:/hooks:Z \
    --volume=%E/state/mailcow/conf/unbound/unbound.conf:/etc/unbound/unbound.conf:ro,Z \
    ${UNBOUND_IMAGE}
ExecStartPost=%E/bin/wait-ready exec %N 120 dig +short +tries=1 +time=2 @127.0.0.1 unbound
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%N.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile=%t/%N.ctr-id
PIDFile=%t/%N.pid
Type=forking
SyslogIdentifier=%N

[Install]
WantedBy=default.target
