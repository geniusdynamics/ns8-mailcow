#
# The mailcow pod. Its containers share one network namespace, so they reach
# each other on the loopback (see bin/create-pod) and use unbound as DNS
# server. The pod publishes the mail ports on the node and the nginx port on
# 127.0.0.1:TCP_PORT for Traefik.
#
# Optional units, started by configure-module according to the settings,
# are not listed here: clamd-mailcow-app (clamd_enabled) and
# netfilter-mailcow-app (netfilter_mode).
#

[Unit]
Description=mailcow pod
Requires=mysql-mailcow-app.service redis-mailcow-app.service memcached-mailcow-app.service unbound-mailcow-app.service dockerapi.service php-fpm-mailcow-app.service sogo-mailcow-app.service dovecot-mailcow-app.service postfix-tlspol-mailcow-app.service postfix-mailcow-app.service olefy-mailcow-app.service rspamd-mailcow-app.service nginx-mailcow-app.service
Before=mysql-mailcow-app.service redis-mailcow-app.service memcached-mailcow-app.service unbound-mailcow-app.service dockerapi.service php-fpm-mailcow-app.service sogo-mailcow-app.service dovecot-mailcow-app.service postfix-tlspol-mailcow-app.service postfix-mailcow-app.service olefy-mailcow-app.service rspamd-mailcow-app.service nginx-mailcow-app.service clamd-mailcow-app.service netfilter-mailcow-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/mailcow.pid %t/mailcow.pod-id
ExecStartPre=%E/bin/create-pod %t
ExecStart=/usr/bin/podman pod start --pod-id-file %t/mailcow.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/mailcow.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/mailcow.pod-id
PIDFile=%t/mailcow.pid
Type=forking
SyslogIdentifier=%N

[Install]
WantedBy=default.target
