[Unit]
Description=Podman  redis-mailcow-app.service
BindsTo=mailcow.service
After=mailcow.service
Before=php-fpm-mailcow-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/redis-mailcow-app.pid %t/redis-mailcow-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/redis-mailcow-app.pid  --cidfile %t/redis-mailcow-app.ctr-id --cgroups=no-conmon  --pod-id-file %t/mailcow.pod-id --replace -d --name  redis-mailcow-app   \
    --volume redis-vol:/data/:Z \
    --volume %E/mailcow/data/conf/redis/redis-conf.sh:/redis-conf.sh:ro,z \
    --env-file redis-mailcow.env \
    --entrypoint=/bin/sh \
    ${REDIS_IMAGE} /redis-conf.sh
# Report started only when Redis answers with its password
ExecStartPost=/usr/bin/podman exec redis-mailcow-app /bin/sh -c "for i in $$(seq 1 60); do redis-cli -a \"$$REDISPASS\" --no-auth-warning ping | grep -q PONG && exit 0; sleep 2; done; exit 1"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/redis-mailcow-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP redis-mailcow-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/redis-mailcow-app.ctr-id
PIDFile=%t/redis-mailcow-app.pid
Type=forking

[Install]
WantedBy=default.target
