# Traefik obtained or renewed a certificate: if it is the one of the mail
# host name, give it to Postfix, Dovecot and nginx, like ns8-mail does

import json
import os
import sys
import agent

event = json.load(sys.stdin)
myname = os.environ.get("MAILCOW_HOSTNAME", "")

if not myname or not agent.certificate_event_matches(event, myname):
    sys.exit(0) # ignore event if not relevant

os.makedirs("ssl", exist_ok=True)
get_proc = agent.run_helper('get-certificate', '--cert-file=ssl/cert.pem', '--key-file=ssl/key.pem', myname)

# Reload the running services if the certificate differs
if get_proc.returncode == 0:
    agent.run_helper('systemctl', '--user', 'try-reload-or-restart',
                     'postfix-mailcow-app.service', 'dovecot-mailcow-app.service', 'nginx-mailcow-app.service')
