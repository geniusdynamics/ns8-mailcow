# Restart mailcow with the new images, if it is configured

set -e

# Redirect any output to the journal (stderr)
exec 1>&2

cd "${AGENT_STATE_DIR}"
if [[ ! -f mailcow.env ]]; then
    exit 0 # not configured yet
fi

# The units of the web-only releases that no longer exist
systemctl --user disable --now acme-mailcow-app.service ofelia-mailcow-app.service watchdog-mailcow-app.service 2>/dev/null || :
systemctl --user daemon-reload

touch .restart-required
exec "${AGENT_INSTALL_DIR}/actions/configure-module/80start_services"
