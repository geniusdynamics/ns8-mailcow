{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get mailcow settings",
    "$id": "http://nethserver.org/json-schema/task/output/mailcow/get-configuration",
    "description": "Get mailcow settings",
    "examples": [
        {
            "host": "mail.example.org",
            "http2https": true,
            "lets_encrypt": true,
            "netfilter_mode": "external",
            "clamd_enabled": true,
            "mail_ports": [25, 465, 587, 143, 993, 110, 995, 4190],
            "mailcow_release": "2026-11"
        }
    ],
    "type": "object",
    "additionalProperties": false,
    "required": [
        "host",
        "http2https",
        "lets_encrypt",
        "netfilter_mode",
        "clamd_enabled"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Mail host name, like 'mail.example.org'. Empty before the first configuration"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "netfilter_mode": {
            "type": "string",
            "enum": ["disabled", "external", "rootful"],
            "description": "netfilter-mailcow mode"
        },
        "clamd_enabled": {
            "type": "boolean",
            "description": "ClamAV runs"
        },
        "mail_ports": {
            "type": "array",
            "items": {"type": "integer"},
            "description": "TCP ports published on the node"
        },
        "mailcow_release": {
            "type": "string",
            "description": "mailcow-dockerized release of the configuration files"
        }
    }
}
