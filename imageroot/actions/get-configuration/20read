# Return the settings. Secrets (database, Redis, SOGo keys, the ban list
# token) are never returned: they stay in the 0600 files of the state
# directory and in the mailcow Redis.

import json
import os
import sys
import mailcow_ns8

settings = mailcow_ns8.settings_from_env()
settings["mail_ports"] = [int(port.split("/")[0]) for port in mailcow_ns8.MAIL_PORTS]
settings["mailcow_release"] = os.getenv("MAILCOW_RELEASE", "")
json.dump(settings, fp=sys.stdout)
