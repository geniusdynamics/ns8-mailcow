# Publish the mailcow UI (nginx of the pod) through Traefik. With
# lets_encrypt, Traefik obtains the certificate of the mail host name, that
# Postfix and Dovecot use too (30certificate, events/certificate-changed).

import json
import os
import sys
import agent

data = json.load(sys.stdin)

agent.set_route({
    'instance': os.environ['MODULE_ID'],
    'url': 'http://127.0.0.1:' + os.environ["TCP_PORT"],
    'host': data["host"],
    'http2https': data.get("http2https", True),
    'lets_encrypt': data.get("lets_encrypt", False),
})
