# Download mailcow-dockerized at a fixed upstream commit. The node has no
# git, so fetch the commit as a tarball.
set -e
exec 1>&2

COMMIT_HASH="4845928e7ada830de451a2e6125a03840b9fdb62"
TARGET_DIR="../mailcow"

if [ -d "$TARGET_DIR" ] && [ -f "$TARGET_DIR/docker-compose.yml" ]; then
    echo "mailcow-dockerized is already present"
    exit 0
fi

mkdir -p "$TARGET_DIR"
python3 - "$COMMIT_HASH" "$TARGET_DIR" <<'PY'
import io
import sys
import tarfile
import urllib.request

commit, target = sys.argv[1], sys.argv[2]
url = f"https://github.com/mailcow/mailcow-dockerized/archive/{commit}.tar.gz"
print(f"Downloading {url}")
with urllib.request.urlopen(url, timeout=120) as resp:
    data = resp.read()
with tarfile.open(fileobj=io.BytesIO(data), mode="r:gz") as tar:
    for member in tar.getmembers():
        # drop the leading mailcow-dockerized-<commit>/ directory
        parts = member.name.split("/", 1)
        if len(parts) < 2 or not parts[1]:
            continue
        member.name = parts[1]
        tar.extract(member, target)
print(f"mailcow-dockerized {commit} extracted to {target}")
PY
