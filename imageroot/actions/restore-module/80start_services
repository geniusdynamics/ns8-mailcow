set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# If the control reaches this step, the service can be enabled and started


systemctl --user enable mailcow.service
systemctl --user enable podman.socket
systemctl --user start podman.socket
systemctl --user restart mailcow.service mysql-mailcow-app.service \
    redis-mailcow-app.service memcached-mailcow-app.service dockerapi.service \
    php-fpm-mailcow-app.service nginx-mailcow-app.service
