# Configure and start mailcow with the settings of the backup. Let's Encrypt
# stays off: the DNS records may not point to this node yet.

import sys
import json
import agent
import os

request = json.load(sys.stdin)
renv = request['environment']

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "lets_encrypt": False,
    "host": renv.get("MAILCOW_HOSTNAME") or renv["TRAEFIK_HOST"],
    "http2https": renv.get("TRAEFIK_HTTP2HTTPS", "True").lower() == "true",
    "netfilter_mode": renv.get("NETFILTER_MODE", "external"),
    "clamd_enabled": renv.get("CLAMD_ENABLED", "True").lower() == "true",
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
