#!/bin/bash

#
# Copyright (C) 2026 Genius Dynamics
# SPDX-License-Identifier: GPL-3.0-or-later
#

# Create the mailcow pod (ExecStartPre of mailcow.service).
#
# - The mail ports are published on all the addresses of the node, like
#   ns8-mail does with host networking: NS8 lowers
#   net.ipv4.ip_unprivileged_port_start to 23, so the rootless pod can bind 25.
# - Postfix, Dovecot and netfilter must see the real address of the clients.
#   pasta, the rootless network of Podman 5, keeps it. slirp4netns keeps it
#   only with its own port handler: rootlessport would show every client as
#   the address of the pod.
# - The containers reach each other on the loopback: the names of
#   mailcow-dockerized resolve to 127.0.0.1 (/etc/hosts here, unbound for dig,
#   see bin/sync-mailcow-data).

set -e

rundir=${1:?usage: create-pod RUNTIME_DIR}

aliases=(
    unbound unbound-mailcow mysql mysql-mailcow redis redis-mailcow
    clamd clamd-mailcow rspamd rspamd-mailcow phpfpm php-fpm-mailcow
    sogo sogo-mailcow dovecot dovecot-mailcow postfix postfix-mailcow
    postfix-tlspol postfix-tlspol-mailcow memcached memcached-mailcow
    nginx nginx-mailcow dockerapi dockerapi-mailcow olefy olefy-mailcow
    netfilter-mailcow watchdog watchdog-mailcow acme acme-mailcow
    dockerapi.mailcowdockerized_mailcow-network
    nginx.mailcowdockerized_mailcow-network
    rspamd.mailcowdockerized_mailcow-network
)

args=()
for alias in "${aliases[@]}"; do
    args+=("--add-host=${alias}:127.0.0.1")
done

for port in 25 465 587 143 993 110 995 4190; do
    args+=("--publish=${port}:${port}")
done

netcmd=$(podman info --format '{{.Host.RootlessNetworkCmd}}' 2>/dev/null || :)
if [[ "${netcmd}" != "pasta" ]]; then
    # Podman 4, or Podman 5 configured for slirp4netns
    args+=("--network=slirp4netns:port_handler=slirp4netns,enable_ipv6=false")
fi

exec /usr/bin/podman pod create \
    --infra-conmon-pidfile="${rundir}/mailcow.pid" \
    --pod-id-file="${rundir}/mailcow.pod-id" \
    --name=mailcow \
    --replace \
    --dns=127.0.0.1 \
    --publish="127.0.0.1:${TCP_PORT:?}:80" \
    "${args[@]}"
