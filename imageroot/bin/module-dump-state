# Runs before the backup, in the state directory

set -e

if ! systemctl --user -q is-active mysql-mailcow-app.service; then
    exit 0
fi

podman exec mysql-mailcow-app sh -c 'exec mariadb-dump -uroot -p"$MYSQL_ROOT_PASSWORD" \
        --databases "$MYSQL_DATABASE" \
        --default-character-set=utf8mb4 \
        --skip-dump-date \
        --ignore-table=mysql.event \
        --single-transaction \
        --quick \
        --add-drop-table' > mysql-mailcow.sql

# Write the Redis data (dump.rdb in redis-vol) to disk
if systemctl --user -q is-active redis-mailcow-app.service; then
    podman exec redis-mailcow-app sh -c 'exec redis-cli -a "$REDISPASS" --no-auth-warning SAVE' >&2
fi
