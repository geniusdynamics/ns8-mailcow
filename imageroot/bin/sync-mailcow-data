"""Copy the vendored mailcow-dockerized files (data/conf, data/web,
data/assets, data/hooks) of the image to the runtime tree state/mailcow,
then apply the NS8 changes.

Run it through "podman unshare": the containers chown some files to their
own users (subordinate UIDs on the host), which only the root of the user
namespace can replace.

- Files of the release are replaced by the new release.
- Files the containers or the admin created are kept (generated SQL maps,
  extra.cf, extra.conf, vars.local.inc.php...).
- The customization points of mailcow (rspamd custom maps, SOGo custom
  logos, global sieve filters) are created once and never overwritten.
- Files of the previous release that the new release dropped are removed.
"""

import filecmp
import json
import os
import shutil
import sys

DIST = os.path.join(os.environ["AGENT_INSTALL_DIR"], "mailcow-dist")
DEST = os.path.join(os.environ["AGENT_STATE_DIR"], "mailcow")
MANIFEST = os.path.join(DEST, ".release-files.json")
SYNCED = ("conf", "web", "assets", "hooks")
# Created once, then owned by the admin (and the mailcow UI)
PRESERVE = (
    "conf/rspamd/custom/",
    "conf/sogo/custom-",
    "conf/dovecot/global_sieve_",
)

# Names the mailcow containers use to reach each other: in the pod they are
# all on the loopback. /etc/hosts of the pod has them (mailcow.service), and
# unbound answers them too, because some scripts query DNS with dig.
ALIASES = [
    "unbound", "unbound-mailcow", "mysql", "mysql-mailcow", "redis", "redis-mailcow",
    "clamd", "clamd-mailcow", "rspamd", "rspamd-mailcow", "phpfpm", "php-fpm-mailcow",
    "sogo", "sogo-mailcow", "dovecot", "dovecot-mailcow", "postfix", "postfix-mailcow",
    "postfix-tlspol", "postfix-tlspol-mailcow", "memcached", "memcached-mailcow",
    "nginx", "nginx-mailcow", "dockerapi", "dockerapi-mailcow", "olefy", "olefy-mailcow",
    "netfilter-mailcow", "watchdog", "watchdog-mailcow", "acme", "acme-mailcow",
]

errors = 0


def warn(message):
    global errors
    errors += 1
    print("<4>sync-mailcow-data: " + message, file=sys.stderr)


def release_files():
    files = []
    for top in SYNCED:
        for root, dirs, names in os.walk(os.path.join(DIST, top)):
            dirs.sort()
            for name in sorted(names):
                files.append(os.path.relpath(os.path.join(root, name), DIST))
    return files


def preserved(rel):
    return rel.startswith(PRESERVE)


def copy_file(rel):
    src = os.path.join(DIST, rel)
    dst = os.path.join(DEST, rel)
    if os.path.lexists(dst):
        if preserved(rel):
            return
        if os.path.isfile(dst) and not os.path.islink(dst) and filecmp.cmp(src, dst, shallow=False):
            if (os.stat(src).st_mode & 0o111) != (os.stat(dst).st_mode & 0o111):
                os.chmod(dst, os.stat(src).st_mode & 0o7777)
            return
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = f"{dst}.ns8-sync.tmp"
    shutil.copyfile(src, tmp)
    os.chmod(tmp, os.stat(src).st_mode & 0o7777)
    if os.path.isdir(dst) and not os.path.islink(dst):
        shutil.rmtree(dst)
    os.replace(tmp, dst)


def write_if_changed(path, content, mode=0o644):
    try:
        with open(path) as fobj:
            if fobj.read() == content:
                os.chmod(path, mode)
                return
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.ns8-sync.tmp"
    with open(tmp, "w") as fobj:
        fobj.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def patch_postfix():
    """mynetworks_style = subnet would trust the whole subnet of the node:
    rootless Podman copies the host address and prefix into the pod. Only
    the pod itself (the other mailcow containers) is trusted."""
    path = os.path.join(DEST, "conf/postfix/main.cf")
    with open(path) as fobj:
        lines = fobj.read().split("\n")
    comment = "# NS8: trust the mailcow pod only"
    line = "mynetworks = 127.0.0.0/8 [::1]/128"
    out = [l for l in lines if not l.startswith("mynetworks =") and l != comment]
    for idx, cur in enumerate(out):
        if cur.startswith("mynetworks_style"):
            out[idx + 1:idx + 1] = [comment, line]
            break
    else:
        out[0:0] = [comment, line]
    write_if_changed(path, "\n".join(out))


def patch_unbound():
    path = os.path.join(DEST, "conf/unbound/unbound.conf")
    with open(path) as fobj:
        content = fobj.read()
    marker = "# NS8: names of the mailcow containers"
    content = content.split("\n" + marker)[0].rstrip("\n") + "\n"
    content += "\n" + marker + ", all in the pod\nserver:\n"
    for alias in ALIASES:
        content += f'  local-data: "{alias}. 300 IN A 127.0.0.1"\n'
    write_if_changed(path, content)


HOOK_DOVECOT = r"""#!/bin/bash
# NS8 (managed by the module, replaced on update)
# The pod shares one network namespace: SOGo connects to Dovecot from
# 127.0.0.1, not from ${IPV4_NETWORK}.248 like in mailcow-dockerized.
sed -i "s#allow_nets=${IPV4_NETWORK}\.248/32#allow_nets=127.0.0.1/32#" /etc/dovecot/sogo-sso.conf
sed -i "s#^remote ${IPV4_NETWORK}\.248 {#remote 127.0.0.1 {#" /etc/dovecot/sogo_trusted_ip.conf
"""

HOOK_POSTFIX = r"""#!/bin/bash
# NS8 (managed by the module, replaced on update)
# Copy the mail log to the journal of the node through its /dev/log socket.
# Lines then read "postfix/smtpd[PID]: ...", as with ns8-mail, so the
# crowdsecurity/postfix collection of NS8 CrowdSec parses them.
[ -S /hostlog/dev-log ] || exit 0
grep -q d_ns8_hostlog /etc/syslog-ng/syslog-ng.conf && exit 0
src=$(sed -n 's/^source \([a-z_]*\) {.*/\1/p' /etc/syslog-ng/syslog-ng.conf | head -n 1)
cat >> /etc/syslog-ng/syslog-ng.conf <<EOF
destination d_ns8_hostlog {
  unix-dgram("/hostlog/dev-log" template("<\${PRI}>\${DATE} \${PROGRAM}[\${PID}]: \${MESSAGE}\n"));
};
log {
  source(${src:-s_src});
  filter(f_mail);
  destination(d_ns8_hostlog);
};
EOF
"""


def install_hooks():
    write_if_changed(os.path.join(DEST, "hooks/dovecot/00-ns8-sogo-sso.sh"), HOOK_DOVECOT, 0o755)
    write_if_changed(os.path.join(DEST, "hooks/postfix/00-ns8-hostlog.sh"), HOOK_POSTFIX, 0o755)


def main():
    if not os.path.isdir(DIST):
        warn(f"{DIST} is missing")
        return 1
    os.makedirs(DEST, exist_ok=True)
    try:
        with open(MANIFEST) as fobj:
            previous = set(json.load(fobj).get("files", []))
    except (FileNotFoundError, ValueError):
        previous = set()
    files = release_files()
    for rel in files:
        try:
            copy_file(rel)
        except OSError as ex:
            warn(f"cannot copy {rel}: {ex}")
    for rel in sorted(previous - set(files)):
        if preserved(rel):
            continue
        try:
            os.unlink(os.path.join(DEST, rel))
        except FileNotFoundError:
            pass
        except OSError as ex:
            warn(f"cannot remove {rel}: {ex}")
    for patch in (patch_postfix, patch_unbound, install_hooks):
        try:
            patch()
        except OSError as ex:
            warn(f"{patch.__name__} failed: {ex}")
    with open(os.path.join(DIST, "RELEASE")) as fobj:
        release = fobj.read().strip()
    write_if_changed(MANIFEST, json.dumps({"release": release, "files": files}, indent=0) + "\n")
    print(f"sync-mailcow-data: mailcow-dockerized {release}, {len(files)} files, {errors} errors", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
